from math import pi, sqrt

type Shape = Circle(r: f64) | Rect(w: f64, h: f64) | Triangle(a: f64, b: f64, c: f64)

fn area(s: Shape) -> f64:
    match s:
        case Circle(r):
            return pi * r * r
        case Rect(w, h):
            return w * h
        case Triangle(a, b, c):
            p = (a + b + c) / 2.0
            return sqrt(p * (p - a) * (p - b) * (p - c))

fn perimeter(s: Shape) -> f64:
    match s:
        case Circle(r):
            return 2.0 * pi * r
        case Rect(w, h):
            return 2.0 * (w + h)
        case Triangle(a, b, c):
            return a + b + c

fn name(s: Shape) -> str:
    match s:
        case Circle(_):
            return "circle"
        case Rect(w, h):
            return "square" if w == h else "rectangle"
        case Triangle(_, _, _):
            return "triangle"

fn valid(s: Shape) -> bool:
    match s:
        case Circle(r):
            return r > 0.0
        case Rect(w, h):
            return w > 0.0 and h > 0.0
        case Triangle(a, b, c):
            return a > 0.0 and b > 0.0 and c > 0.0 and a < b + c and b < a + c and c < a + b

fn largest(shapes: [Shape]) -> Shape?:
    """The shape of greatest area, the first of them on a tie; None for no shapes."""
    if len(shapes) == 0:
        return None
    var best = shapes[0]
    for s in shapes:
        if area(s) > area(best):
            best = s
    return best

test "rect":
    assert area(Rect(2.0, 3.0)) == 6.0
