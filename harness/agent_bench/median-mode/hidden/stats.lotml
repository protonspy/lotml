test "hidden: median odd":
    assert median([5.0, 1.0, 3.0]) == 3.0

test "hidden: median even":
    assert median([4.0, 1.0, 3.0, 2.0]) == 2.5

test "hidden: median empty":
    assert median([]) is None

test "hidden: median leaves its input":
    xs = [2.0, 1.0]
    assert median(xs) == 1.5
    assert xs == [2.0, 1.0]

test "hidden: mode":
    assert mode([3, 1, 3, 2]) == 3

test "hidden: mode tie takes the smallest":
    assert mode([5, 4, 5, 4, 9]) == 4

test "hidden: mode empty":
    assert mode([]) is None
