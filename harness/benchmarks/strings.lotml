fn main():
    var parts: [str] = []
    for i in range(600000):
        parts.append(f"item-{i}:{i * 7 % 1000}")
    joined = ",".join(parts)
    var total = 0
    for p in joined.split(","):
        kv = p.split(":")
        total += len(kv[0]) + (kv[1].to_int() ?? 0)
    print(len(joined), total)
