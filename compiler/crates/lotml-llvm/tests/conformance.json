 "rules": {
  "functions": "Functions and locals: definitions, calls, `var`, recursion (reference/lotml.md, Functions and locals)",
  "numbers.int": "`int` arithmetic, Python's floor division and modulo, comparisons (Numbers)",
  "numbers.overflow": "an integer result outside its type stops the program (Numbers)",
  "numbers.float": "`f64` and `f32` arithmetic and Python's `repr` of a float (Numbers)",
  "numbers.sized": "`i8` to `u64`, their ranges and conversions (Numbers)",
  "numbers.division": "`/` of integers returns `f64` (adr:0007)",
  "strings": "`str` literals, indexing and slicing by character, concatenation (Strings)",
  "strings.methods": "the methods of `str`: split, join, find, strip and the rest (Strings)",
  "strings.format": "f-strings and the format mini-language (Strings)",
  "print": "`print` and `repr` of every kind of value, as Python prints them (Strings, Collections)",
  "collections.lists": "lists, their literals, comprehensions, indexing, slicing and methods (Collections)",
  "collections.dicts": "dicts in insertion order, their methods and comprehensions (Collections)",
  "collections.sets": "sets and their operations (Collections)",
  "collections.tuples": "tuples, unpacking, `enumerate` and `zip` (Collections)",
  "records": "records: construction, fields, value semantics on assignment (Records)",
  "sum-types": "sum types and `match` over their variants (Sum types and `match`)",
  "optionals": "`T?`, `None`, `??` and narrowing (Optionals)",
  "errors": "errors as values: `T ! E`, `fail`, `?`, an error out of `main` (Errors as values)",
  "unfinished": "`todo()` and `assert` stopping the program (Unfinished code)",
  "parameters": "parameters read, `inout` and `sink` (Parameters)",
  "methods-traits": "methods in `impl` and traits with defaults (Methods and traits)",
  "generics": "generic functions and types, and recursive types (Generics)",
  "control-flow": "`if`, `elif`, `while`, `for` over ranges and collections, `break`, `continue` (Control flow)",
  "lambdas": "lambdas and functions as values (Functions and locals)",
  "concurrency": "`parallel` and a panic inside it (Concurrency)",
  "prelude": "the prelude's functions: math, `sorted`, `min`, `max`, `sum` and the rest (Modules and the prelude)",
  "tests": "`test` blocks and what `lotml test` reports of them (Tests)",
  "memory": "every cell a program allocates is freed by its end, natively (adr:0003)"
