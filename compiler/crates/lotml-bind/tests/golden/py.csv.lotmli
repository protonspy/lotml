# A parameter written `= todo()` is optional: Python supplies its default.
# A `PyObject` is a value no LotML type describes: convert it with `value()`.

class Dialect:
    fn Dialect() -> Dialect ! PyError
    delimiter: str
    quotechar: str?
    escapechar: str?
    doublequote: bool
    skipinitialspace: bool
    lineterminator: str
    quoting: PyObject
    strict: bool

class excel(Dialect):
    fn excel() -> excel ! PyError

class excel_tab(excel):
    fn excel_tab() -> excel_tab ! PyError

class unix_dialect(Dialect):
    fn unix_dialect() -> unix_dialect ! PyError

class Sniffer:
    preferred: [str]
    fn sniff(self, sample: str, delimiters: str? = None) -> PyObject ! PyError
    fn has_header(self, sample: str) -> bool ! PyError

