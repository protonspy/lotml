import math
from math import sqrt, pi

type P(x: int, tag: str)

fn main():
    print(round(2.5), round(3.5), round(-2.5), round(0.5), round(7), round(-7.6))
    print(round(2.675, 2), round(1234.5678, -2), round(-0.0, 1), round(1.5e300, 2), round(0.125, 2), round(2.5, 0))
    var maybe: int? = 0
    var none: str? = None
    print(bool(0), bool(3), bool(""), bool("a"), bool([0]), bool(0.0), bool(-1.5), bool({1: 2}), bool({1}), bool(maybe), bool(none), bool(P(0, "")))
    print(hash(1), hash(-1), hash(-2), hash(2.5), hash(-0.5), hash(True), hash("abc"), hash((1, "a")), hash(P(3, "x")))
    print(pow(2, 10), pow(2.0, 0.5), pow(3, 4, 5), pow(3, -1, 7), pow(-7, 3, 5), pow(7, 2, -5), pow(10, 18, 9223372036854775807))
    print(divmod(7, 2), divmod(-7, 2), divmod(7, -2), divmod(7.5, 2.0), divmod(-7.5, 2.0), divmod(7.0, -2.0))
    print(wrapping_add(9223372036854775807, 1), wrapping_sub(-9223372036854775807 - 1, 1), wrapping_mul(4611686018427387904, 4), wrapping_mul(-3, 5))
    print(isqrt(0), isqrt(15), isqrt(16), isqrt(9223372036854775807), gcd(12, 18), gcd(-4, 6), gcd(0, 0), gcd(0, -5))
    print(math.sqrt(2.0), sqrt(16), math.floor(2.7), math.floor(-2.5), math.ceil(2.1), math.trunc(-2.7), math.floor(5), pi)
    print(math.pow(2, 0.5), math.log(10), math.log2(8), math.log10(1000), math.exp(1), math.sin(0.5), math.cos(0.5), math.tan(0.5))
    print(math.atan(1), math.atan2(1, 2), math.hypot(3, 4), math.fabs(-2), math.pi, math.e, math.inf, -math.inf)
    print(math.gcd(12, 8), math.isqrt(99), math.factorial(20), math.comb(60, 30), math.perm(10, 3), math.comb(5, 7), math.comb(66, 33))
    var h = Heap([5, 1, 4, 1, 3])
    h.push(0)
    h.push(2)
    print(len(h), h.peek())
    var out: [int] = []
    while len(h) > 0:
        out.append(h.pop_min() ?? -1)
    print(out, h.pop_min(), h.peek(), bool(h))
    var words: Heap[str] = Heap()
    for w in ["pear", "fig", "apple", "kiwi"]:
        words.push(w)
    var pairs = Heap([(2, "b"), (1, "z"), (1, "a"), (0, "q")])
    print(words.pop_min(), words.pop_min(), pairs.pop_min(), pairs.pop_min(), len(words), bool(words))
    print(i8(100), u8(255), i16(-300), u16(65535), i32(2147483647), u32(4294967295), u64(9223372036854775807), f32(1.5), i64(3.9), int(-3.9))
    var a: i32 = 2147483000
    a += i32(600)
    b: u8 = 200
    print(a, b + 55, b // 3, b % 7, -a, float(a), i8(-3.7))
