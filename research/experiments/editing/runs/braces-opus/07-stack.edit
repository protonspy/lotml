    fn size(self) -> int {
        return len(self.items)
    }

    fn pop_n(var self, n: int) -> [T] {
        var out: [T] = []
        while len(out) < n {
            item = self.items.pop()
            if item is not None {
                out.append(item)
            } else {
                break
            }
        }
        return out
    }
