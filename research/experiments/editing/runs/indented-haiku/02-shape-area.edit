fn area(s: Shape) -> f64:
    match s:
        case Circle(r):
            return pi * r * r
        case Rect(w, h):
            return w * h
        case Triangle(a, b, c):
            p = (a + b + c) / 2.0
            return sqrt(p * (p - a) * (p - b) * (p - c))
        case Square(side):
            return side * side
