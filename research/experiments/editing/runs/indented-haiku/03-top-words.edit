fn top_words(text: str, k: int) -> [(str, int)]:
    var counts: {str: int} = {}
    for w in text.split():
        if len(w) >= 3 and w.isalpha():
            key = w.lower()
            counts[key] = counts.get(key, 0) + 1
    pairs = sorted(counts.items(), key=lambda p: -p[1])
    return pairs[:k]
