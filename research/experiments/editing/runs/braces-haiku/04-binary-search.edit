fn binary_search(xs: [int], target: int) -> int? {
    var lo = 0
    var hi = len(xs) - 1
    var result = None
    while lo <= hi {
        mid = (lo + hi) // 2
        if xs[mid] == target {
            result = mid
            hi = mid - 1
        } else if xs[mid] < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return result
}
