fn find_adult(users: [User], name: str) -> User ! LookupErr {
    u = users.find(lambda u: u.name == name) ?? fail NotFound(name)
    if u.age < 18 {
        fail Minor(u.age)
    }
    if u.email is None {
        fail NoEmail(u.name)
    }
    return u
