fn depth(j: Json) -> int {
    match j {
        case Arr(items) {
            return 1 + max((depth(i) for i in items), default=0)
        }
        case Obj(fields) {
            return 1 + max((depth(v) for v in fields.values()), default=0)
        }
        case _ {
            return 0
        }
    }
}
